<?xml version="1.0" encoding="utf-8"?>
<!--
  English keys for Radius UI - Quest Menu. Ships so keys resolve at runtime and so
  translators have a complete template.
  House style (GLOBAL_RULES §7 + 2026-08-17 review round): vanilla sentence case with the
  FIRST word capitalised everywhere a string stands alone; ASCII only (comma separators,
  spaced hyphen - never a middot, em dash or en dash); no trailing period on labels.
  "AcceptQuest" is not here - the vanilla key is reused so the button matches the base game.
-->
