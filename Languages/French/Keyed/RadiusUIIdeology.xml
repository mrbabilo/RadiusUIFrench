  <!-- World standing. Replaces the pairwise conversion-pressure list: prevalence is a global
       question, and RimWorld exposes no per-settlement population, so share of known
       settlements plus faction count is the only honest measure of it. -->
  <RadiusIdeo_Standing>Place dans le monde</RadiusIdeo_Standing>
  <RadiusIdeo_NSettlements>{0} colonies</RadiusIdeo_NSettlements>
  <RadiusIdeo_NFactions>{0} factions</RadiusIdeo_NFactions>
  <RadiusIdeo_StandingTip>Suivie dans {0} des {1} colonies connues, réparties entre {2} factions.</RadiusIdeo_StandingTip>

  <!-- ===== Rail: sections, row subtitle, relation chips =====
       The relation chip answers "why do I care about this faith" in one word. Hostile wins
       over ally when a faith is carried by both, so the word is never reassuring about a
       belief the raiders also hold. -->
  <RadiusIdeo_RailColony>Colonie</RadiusIdeo_RailColony>
  <RadiusIdeo_RailKnown>Connues</RadiusIdeo_RailKnown>
  <RadiusIdeo_RailSub>{0} adeptes · {1} mèmes</RadiusIdeo_RailSub>
  <RadiusIdeo_RelYours>La vôtre</RadiusIdeo_RelYours>
  <RadiusIdeo_RelAlly>Alliée</RadiusIdeo_RelAlly>
  <RadiusIdeo_RelHostile>Hostile</RadiusIdeo_RelHostile>
  <RadiusIdeo_RelNeutral>Neutre</RadiusIdeo_RelNeutral>

  <!-- A colonist with no role. Lower case on purpose: it is a rank chip beside "Leader" and
       "Moral guide", and capitalising it would imply it is a role too. -->
  <RadiusIdeo_Believer>croyant</RadiusIdeo_Believer>

  <!-- ===== Atlas framing =====
       The band does not re-frame when you click a settlement, and a map that stays put when
       you expected it to move looks broken unless it says so. The caption is that sentence;
       the header word is the way to move it. -->
  <RadiusIdeo_RangeFixed>Échelle figée jusqu'au prochain ajustement</RadiusIdeo_RangeFixed>
  <RadiusIdeo_ReachOverlay>Calque de portée</RadiusIdeo_ReachOverlay>
  <RadiusIdeo_ReachOverlayTip>Afficher la portée de cette foi et ajuster la carte autour.</RadiusIdeo_ReachOverlayTip>

