<?xml version="1.0" encoding="utf-8"?>
<!--
  English keys for Radius UI - Health Tab. Ships so keys resolve at runtime AND so
  translators have a complete template to copy.

  House style, applied here and enforced on every new string:
    - Sentence case. Only proper nouns and the first word are capitalised.
    - ASCII only, except the three glyphs the suite already uses: \u25b8 \u25be \u00d7
    - No trailing periods on labels; full stops only in sentences and tooltips.
    - {0}/{1} are ordinal so translators can reorder freely.
-->
<!-- Traduction française : mod « Radius UI - Traduction française » (mrbabilo). -->
<LanguageData>

  <!-- Identity -->
  <RadiusUI.HealthTab.Title>Radius UI - Health Tab</RadiusUI.HealthTab.Title>
  <RadiusUI.HealthTab.Set.UseModern>Utiliser l'onglet santé Radius</RadiusUI.HealthTab.Set.UseModern>
  <RadiusUI.HealthTab.Set.TabScale>Taille de l'onglet : {0}</RadiusUI.HealthTab.Set.TabScale>
  <RadiusUI.HealthTab.Set.TabScaleTip>La place que prend l'onglet santé à l'écran. 100 % est la taille prévue, et c'est ce qu'il vous faut presque toujours : utilisez l'échelle d'interface des options de RimWorld pour agrandir ou réduire toute l'interface. Ne baissez cette valeur que pour raccourcir l'onglet sur un petit écran : le texte garde sa taille quand l'onglet rétrécit, donc les libellés se serrent sous 85 % environ.</RadiusUI.HealthTab.Set.TabScaleTip>
  <RadiusUI.HealthTab.SwapToModern>Passer à l'onglet santé Radius</RadiusUI.HealthTab.SwapToModern>

  <!-- Panel tabs -->
  <RadiusUI.HealthTab.Tab.Timeline>Chronologie</RadiusUI.HealthTab.Tab.Timeline>
  <RadiusUI.HealthTab.Tab.Chronic>Chronique</RadiusUI.HealthTab.Tab.Chronic>
  <!-- Body replaced Augmentations: same hediff set, read from the other end. The key
       name must stay in sync with the PanelMode member, because the settings screen
       resolves a tab's label as "RadiusUI.HealthTab.Tab." + the enum name. -->
