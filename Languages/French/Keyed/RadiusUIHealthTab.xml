  <RadiusUI.HealthTab.Tab.Triage>Triage</RadiusUI.HealthTab.Tab.Triage>
  <RadiusUI.HealthTab.Tab.Contagion>Contagion</RadiusUI.HealthTab.Tab.Contagion>
